NODE_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/shasanadesh

B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=

OCR_LANGS=hin+eng
OCR_DPI=300
TESSERACT_BIN=/opt/homebrew/bin/tesseract
PDFTOPPM_BIN=/opt/homebrew/bin/pdftoppm
PDFTOTEXT_BIN=/opt/homebrew/bin/pdftotext

SHASANADESH_BASE_URL=https://shasanadesh.up.gov.in
CRAWL_DELAY_MS=3000
CRAWL_CONCURRENCY_PER_DOMAIN=1

# Retrieval/RAG services
RETRIEVAL_BASE_URL=http://127.0.0.1:8788
API_PORT=8787
RAG_TOP_K=5

# OpenAI-compatible generator
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Local/dev generator defaults. Production may point these at vLLM or another
# OpenAI-compatible inference service.
LLM_BASE_URL=http://127.0.0.1:8790/v1
LLM_MODEL=mlx-community/Qwen3-8B-4bit
LLM_API_KEY=
LLM_MAX_TOKENS=900
LLM_TEMPERATURE=0.1

# Serialize MPS retrieval and MLX generation on one Apple Silicon GPU.
# Disable in production when they run on isolated workers/GPUs.
LOCAL_GPU_SERIALIZE=1

# One repair pass should be concise; local laptop default.
LLM_REPAIR_MAX_TOKENS=450
