NODE_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
# Time zone for dates printed by reports (stored timestamps stay UTC).
# The web app has its own NEXT_PUBLIC_APP_TIME_ZONE in apps/web/.env.local.
APP_TIME_ZONE=Asia/Kolkata

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/shasanadesh

B2_NATIVE_API_URL=https://api.backblazeb2.com
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_REQUIRED=0

LLM_BASE_URL=http://127.0.0.1:8791/v1
LLM_API_KEY=local-development
LLM_MODEL=mlx-community/Qwen3-8B-4bit

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=

OCR_LANGS=hin+eng
OCR_DPI=300
TESSERACT_BIN=/opt/homebrew/bin/tesseract
PDFTOPPM_BIN=/opt/homebrew/bin/pdftoppm
PDFTOTEXT_BIN=/opt/homebrew/bin/pdftotext
PDFINFO_BIN=/opt/homebrew/bin/pdfinfo

SHASANADESH_BASE_URL=https://shasanadesh.up.gov.in
CRAWL_DELAY_MS=3000
DOE_GFR_MAX_PAGES=3
CRAWLER_USER_AGENT=ShasanadeshArchive/0.1 (government document research)
CRAWL_CONCURRENCY_PER_DOMAIN=1
# Optional: override the user agent for Shasanadesh downloads only.
SHASANADESH_USER_AGENT=

# Retrieval/RAG services
RETRIEVAL_BASE_URL=http://127.0.0.1:8788
API_PORT=8787
# Optional comma-separated origins allowed to call the API directly (CORS).
# Leave empty: browsers use the same-origin Next.js proxy.
CORS_ORIGINS=
RAG_TOP_K=5
# Candidates reranked per question (fewer = faster rerank, possibly lower recall).
RAG_RERANK_COUNT=24

# Generation limits. For production, point the model settings above at a hosted
# OpenAI-compatible inference service.
LLM_MAX_TOKENS=900
LLM_TEMPERATURE=0.1

# Serialize MPS retrieval and MLX generation on one Apple Silicon GPU.
# Disable in production when they run on isolated workers/GPUs.
LOCAL_GPU_SERIALIZE=1

# One repair pass should be concise; local laptop default.
LLM_REPAIR_MAX_TOKENS=450

# Development cookie session lifetime.
SESSION_TTL_DAYS=30

# Chat-only adjacent-page context expansion.
RAG_NEIGHBOR_RADIUS=1
RAG_MAX_EVIDENCE_PAGES=7
