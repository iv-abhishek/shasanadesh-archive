# Server-side Next.js proxy target.
# The browser talks only to the same-origin Next.js route.
RAG_API_BASE_URL=http://127.0.0.1:8787

# How dates and times are shown in the app. Stored timestamps are UTC; these
# settings keep question times and the Today/Yesterday groups in IST even when
# the app is hosted on a UTC server. NEXT_PUBLIC_* values are fixed at build
# time: rebuild (or restart dev) after changing them.
NEXT_PUBLIC_APP_TIME_ZONE=Asia/Kolkata
NEXT_PUBLIC_APP_LOCALE=en-IN
